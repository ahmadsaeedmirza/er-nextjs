//- 1. Mobile Header (Visible only on small screens)
header(class="md:hidden flex items-center justify-between p-4 bg-[#Cf1745] border-b border-slate-200")
    div(class="flex items-center gap-2")
        div(class="bg-primary rounded-lg flex items-center justify-center text-white")
            span(class="material-symbols-outlined") 
                img(src="/images/logo-white.png", alt="E & R Salon", class="w-[100px] h-auto")
        h1(class="text-lg italic font-semibold text-white text-lg") E & R Salon 
    //- Buttons: We hide/show these using JS
    button(id="openSidebar" class="p-2")
        i(class="fa-solid fa-bars text-white text-lg")
    
    //- Add 'hidden' here initially so it doesn't show when page loads
    button(id="closeSidebar" class="hidden p-2 text-white")
        i(class="fa-solid fa-xmark text-lg")

//- 2. Sidebar Overlay (Hidden by default, slides in on mobile)
aside(id="sidebar" class="fixed inset-y-0 text-white left-0 z-50 w-64 bg-[#Cf1745] border-r border-slate-200 flex-col hidden md:flex transition-transform duration-300 -translate-x-full md:translate-x-0")
    div(class="p-6")
        div(class="bg-primary rounded-lg text-white")
            img(src="/images/logo-white.png", alt="E & R Salon", class="w-[100px] h-auto")

    nav(class="flex-1 px-4 space-y-1 overflow-y-auto")
        .pb-4
            div(class="flex items-center gap-3 mb-2 px-3")
                p(class="text-xs font-semibold text-white uppercase tracking-wider whitespace-nowrap") Main Menu
                div(class="flex-1 h-px bg-white")
            a(class="flex items-center gap-3 px-3 pt-3 pb-2 mb-3 relative group transition-all duration-300" href="/dashboard")
                i(class="fa-solid text-white fa-chart-line")
                span(class="text-sm font-medium") Dashboard
                    span(class="absolute left-0 -bottom-1 w-full h-0.5 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left")
            a(class="flex items-center gap-3 px-3 pt-3 pb-2 mb-3 relative group transition-all duration-300" href="/manageOrders")
                i(class="fa-solid text-white fa-shopping-cart")
                span(class="text-sm font-medium") Orders
                    span(class="absolute left-0 -bottom-1 w-full h-0.5 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left")
            a(class="flex items-center gap-3 px-3 pt-3 pb-2 mb-3 relative group transition-all duration-300" href="/manageProducts")
                i(class="fa-solid text-white fa-warehouse")
                span(class="text-sm font-medium") Inventory
                    span(class="absolute left-0 -bottom-1 w-full h-0.5 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left")
            a(class="flex items-center gap-3 px-3 pt-3 pb-2 mb-3 relative group transition-all duration-300" href="/manageAppointments")
                i(class="fa-solid text-white fa-calendar")
                span(class="text-sm font-medium") Appointments
                    span(class="absolute left-0 -bottom-1 w-full h-0.5 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left")
            a(class="flex items-center gap-3 px-3 pt-3 pb-2 mb-3 relative group transition-all duration-300" href="#")
                i(class="fa-solid text-white fa-gear")
                span(class="text-sm font-medium") Settings
                    span(class="absolute left-0 -bottom-1 w-full h-0.5 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left")
        
    h1(class="p-6 italic font-semibold") E & R Salon

//- 3. JavaScript Logic (Embedded in the file for convenience)
block scripts
    script(src="/js/toggleHamMenu.js")