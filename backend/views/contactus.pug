extends base 

block content

    main(class="font-display bg-background-light text-stone-800 antialiased transition-colors duration-300")
        div
            //- Hero Split Section
            section(class="relative min-h-[600px] flex flex-col md:flex-row bg-[#F8F6F6] pt-[100px]")
                //- Left: Contact Details
                div(class="w-full md:w-1/2 p-12 lg:p-24 flex flex-col justify-center")
                    div(class="max-w-md")
                        h1(class="text-5xl font-extralight tracking-tight mb-8")
                            | Visit the
                            span(class="font-semibold text-primary italic")  Salon
                        p(class="text-stone-500 mb-12 text-lg leading-relaxed")
                            | Experience the pinnacle of luxury hair and beauty treatments in our serene, marble-accented sanctuary.
          
                        div(class="space-y-10")
                            //- Address
                            div(class="flex items-start space-x-6")
                                div(class="flex-shrink-0 w-12 h-12 bg-[#CF17451A] rounded-xl flex items-center justify-center")
                                    span(class="material-icons text-primary") 
                                        i(class="fa-solid fa-location-dot text-[#CF1745]")
                                div
                                    h3(class="text-xs font-bold uppercase tracking-widest text-primary mb-1") Our Location
                                    p(class="text-lg") 1221 Avenue of the Americas
                                        br
                                        | New York, NY 10020
                                    a(class="text-xs font-bold uppercase tracking-widest text-[#CF174599] hover:text-[#CF1745] mt-2 inline-block transition-colors", href="https://maps.app.goo.gl/QrYeabnGPKS1rkV6A") View on Google Maps
            
                            //- Phone
                            div(class="flex items-start space-x-6")
                                div(class="flex-shrink-0 w-12 h-12 bg-[#CF17451A] rounded-xl flex items-center justify-center")
                                    span(class="material-icons text-primary") 
                                        i(class="fa-solid fa-phone text-[#CF1745]")
                                div
                                    h3(class="text-xs font-bold uppercase tracking-widest text-primary mb-1") Reservation Desk
                                    p(class="text-lg") +1 (212) 555-0198
                                    p(class="text-stone-400 text-sm italic") Mon - Sat: 9am to 8pm
            
                            //- Email
                            div(class="flex items-start space-x-6")
                                div(class="flex-shrink-0 w-12 h-12 bg-[#CF17451A] rounded-xl flex items-center justify-center")
                                    span(class="material-icons text-primary") 
                                        i(class="fa-solid fa-at text-[#CF1745]")
                                div
                                    h3(class="text-xs font-bold uppercase tracking-widest text-primary mb-1") General Inquiries
                                    p(class="text-lg") concierge@marbleluxe.com

                        //- Socials
                        div(class="mt-16 pt-10 border-t border-stone-200 flex items-center space-x-8")
                            a(class="text-stone-400 hover:text-[#CF1745] transition-colors", href="#")
                                i(class="fa-brands fa-facebook text-2xl") 
                            a(class="text-stone-400 hover:text-[#CF1745] transition-colors", href="#")
                                span(class="fa-brands fa-instagram text-2xl") 
                            a(class="text-stone-400 hover:text-[#CF1745] transition-colors", href="#")
                                span(class="fa-solid fa-at text-2xl") 
                            span(class="text-xs font-bold uppercase tracking-widest text-stone-300") Follow Our Journey

                //- Right: Interactive Map Area
                div(class="w-full md:w-1/2 h-[500px] md:h-auto relative overflow-hidden bg-stone-100 group")
                    div(class="absolute inset-0 grayscale-map opacity-80 group-hover:opacity-100 transition-opacity duration-700")
                        a(src="https://maps.app.goo.gl/QrYeabnGPKS1rkV6A")
                            img(
                                src="/images/map.png",
                                alt="Map of 1221 Avenue of the Americas",
                                class="w-full h-full object-cover group-hover:opacity-100 transition-opacity duration-700"
                            )

                    //- //- Custom Pin Marker
                    //- div(class="absolute top-1\/2 left-1\/2 -translate-x-1\/2 -translate-y-1\/2 flex flex-col items-center")
                    //-     div(class="bg-[#CF1745] text-white p-3 rounded-full shadow-2xl animate-bounce")
                    //-         i(class="fa-solid fa-spa text-3xl") 
                    //-     div(class="mt-2 bg-white\/95 backdrop-blur-sm px-4 py-2 rounded shadow-lg border border-[#CF174533]")
                    //-         span(class="text-xs font-bold uppercase tracking-tighter") E&R Salon
        
                    //- //- Map Overlay UI
                    //- div(class="absolute bottom-8 right-8 flex flex-col space-y-2")
                    //-     button(class="w-10 h-10 bg-white shadow-xl rounded flex items-center justify-center text-[#CF1745] hover:bg-[#CF1745] hover:text-white transition-colors")
                    //-         span(class="material-icons text-3xl") +
                    //-     button(class="w-10 h-10 bg-white shadow-xl rounded flex items-center justify-center text-[#CF1745] hover:bg-[#CF1745] hover:text-white transition-colors")
                    //-         span(class="material-icons text-3xl") -

            //- Inquiry Form Section
            section(class="py-24 px-6 bg-[#F8F6F6]")
                div(class="max-w-4xl mx-auto")
                    div(class="text-center mb-16")
                        h2(class="text-xs font-bold uppercase tracking-[0.3em] text-[#CF1745] mb-4") Inquiry
                        h3(class="text-4xl font-extralight")
                            | Send us a 
                            span(class="font-semibold italic") Message
                        div(class="w-12 h-1 bg-[#CF1745] mx-auto mt-6")
        
                    div(class="bg-[#ffffff66] backdrop-blur-xl p-8 lg:p-16 rounded-xl bg-[#E7E5E4/60] shadow-2xl")
                        form(class="grid grid-cols-1 md:grid-cols-2 gap-8")
                            div(class="space-y-1")
                                label(class="text-[10px] font-bold uppercase tracking-widest text-stone-400 px-1") Full Name
                                input(class="w-full bg-[#ffffff] border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all", placeholder="Johnathan Doe", type="text")
            
                            div(class="space-y-1")
                                label(class="text-[10px] font-bold uppercase tracking-widest text-stone-400 px-1") Email Address
                                input(class="w-full bg-[#ffffff] border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all", placeholder="john@example.com", type="email")
            
                            div(class="md:col-span-2 space-y-1")
                                label(class="text-[10px] font-bold uppercase tracking-widest text-stone-400 px-1") Subject
                                select(class="w-full bg-[#ffffff] border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all")
                                    option Special Events & Bridal
                                    option Corporate Bookings
                                    option Career Opportunities
                                    option Other Inquiry
            
                            div(class="md:col-span-2 space-y-1")
                                label(class="text-[10px] font-bold uppercase tracking-widest text-stone-400 px-1") How can we help?
                                textarea(class="w-full bg-white\/50 border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all", placeholder="Tell us more about your request...", rows="5")

                            div(class="md:col-span-2 text-center pt-4")
                                button(class="bg-[#CF1745] text-white px-12 py-4 rounded-full text-xs font-bold tracking-[0.2em] uppercase hover:bg-[#CF1745E6] transition-all shadow-xl shadow-[#CF17454D] flex items-center justify-center mx-auto space-x-2", type="submit")
                                    span Send Inquiry
                                    span(class="material-icons text-sm") 
                                        i(class="fa-solid fa-arrow-right")
                                p(class="text-[10px] text-stone-400 uppercase tracking-widest mt-6") We typically respond within 24 business hours             