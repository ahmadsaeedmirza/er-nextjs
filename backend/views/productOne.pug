extends base 

block content 

    section(class="max-w-7xl mx-auto px-6 pb-24 pt-[169px]")
        div(class="flex flex-col md:flex-row gap-12")
            //- 2/3 Image Container
            div(class="w-full md:w-2/3")
                div(class="relative")
                    img(class="w-full h-[500px] rounded-lg object-cover", 
                        src=`/images/products/${product.productImage}`, 
                        alt=product.name
                    )
                    if product.stockQuantity === 0
                        div(class="absolute top-4 right-4 bg-red-500 text-white text-[10px] font-bold px-3 py-1 uppercase tracking-widest") Out of Stock

            //- 1/3 Product Info Container
            div(class="w-full md:w-1/3 flex flex-col justify-center")
                h2(class="text-3xl font-bold text-slate-900 mb-4")= product.name 
                p(class="text-slate-600 mb-6")= product.description 
                if product.stockQuantity < 10 && product.stockQuantity > 0
                    p(class="text-orange-600 text-sm font-semibold mb-4") Only #{product.stockQuantity} left in stock
      
                if product.stockQuantity === 0
                    p(class="text-red-500 text-sm font-semibold mb-8") Out of Stock
                    //- Quantity Selector (disabled)
                    div(class="flex items-center mb-8 opacity-50")
                        span(class="text-sm font-bold uppercase tracking-widest mr-4") Quantity:
                        div(class="flex items-center border border-slate-300 rounded-full") 
                            button(id="decrement", class="w-10 h-10 flex items-center justify-center cursor-pointer text-lg", disabled) −
                            span(id="quantity", class="px-4 text-sm") 1
                            button(id="increment" ,class="w-10 h-10 flex items-center justify-center cursor-pointer text-lg", disabled, data-stock=product.stockQuantity) +
      
                    //- Add to Cart Button (disabled)
                    button(
                        class="bg-gray-400 text-white py-4 px-8 rounded-full font-bold uppercase tracking-widest cursor-not-allowed",
                        disabled,
                        data-stock=product.stockQuantity
                        )
                        | Add to Cart 
                else
                    //- Quantity Selector
                    div(class="flex items-center mb-8")
                        span(class="text-sm font-bold uppercase tracking-widest mr-4") Quantity:
                        div(class="flex items-center border border-slate-300 rounded-full") 
                            button(id="decrement", class="w-10 h-10 flex items-center justify-center cursor-pointer text-lg") −
                            span(id="quantity", class="px-4 text-sm") 1
                            button(id="increment" ,class="w-10 h-10 flex items-center justify-center cursor-pointer text-lg", data-stock=product.stockQuantity) +
      
                    //- Add to Cart Button
                    button(
                        class="add-to-cart-btn bg-[#CF1745] text-white py-4 px-8 rounded-full font-bold uppercase tracking-widest cursor-pointer transition-colors",
                        data-id=product.id,
                        data-name=product.name,
                        data-price=product.price,
                        data-image=product.productImage,
                        data-detail=product.description,
                        data-stock=product.stockQuantity
                        )
                        | Add to Cart 
block scripts
    script(src="/js/cart.js")