extends base

mixin hairService(imgUrl, altText, price, title, description, duration)
  div(class="service-card group bg-[#f8f6f6] rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all")
    div(class="h-64 overflow-hidden relative")
      img(class="service-image w-full h-full object-cover transition-transform duration-700 hover:scale-[1.05]", src=imgUrl, alt="Hair Service", data-alt=altText)
      div(class="absolute top-4 right-4 bg-white/90 px-3 py-1 rounded text-primary font-bold text-sm")
        | From $#{price}
    div(class="p-8")
      h3(class="text-xl font-bold mb-2")= title
      p(class="text-sm opacity-70 mb-6 leading-relaxed")= description
      div(class="flex items-center justify-between")
        span(class="text-xs font-semibold uppercase tracking-widest opacity-50")= duration + " Minutes"
        a(class="flex items-center gap-2 text-primary font-bold text-[#CF1745E6] group-hover:translate-x-1 transition-transform", href="/bookAppointment?service=" + title)
          | BOOK NOW
          span(class="material-icons text-sm") 
            i(class="fa-solid fa-chevron-right text-[#CF1745E6]")

mixin skinCard(imgUrl, altText, category, title, description, price)
  div(class="group flex flex-col md:flex-row bg-[#f8f6f6] rounded-xl overflow-hidden hover:shadow-2xl transition-all")
    //- Image Container
    div(class="md:w-2/5 h-64 md:h-auto overflow-hidden")
      img(
        src=imgUrl, 
        alt=title, 
        data-alt=altText,
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
      )
    //- Content Container
    div(class="md:w-3/5 p-10 flex flex-col justify-center")
      div(class="text-primary font-bold text-sm mb-2 uppercase tracking-widest")= category
      h3(class="text-2xl font-bold mb-4")= title
      p(class="text-sm opacity-70 mb-8 leading-relaxed")= description
      
      div(class="flex items-center justify-between mt-auto")
        span(class="text-lg font-bold text-[#CF1745E6]")= price
        a(class="bg-[#CF1745E6] text-white px-6 py-2 rounded text-xs font-bold tracking-widest hover:bg-black transition-colors", href="/bookAppointment?service=" + title)
          | BOOK APPOINTMENT

mixin nailCard(icon, title, description, price)
  div(class="bg-white p-8 rounded-xl border border-[#cf17450d] shadow-sm hover:-translate-y-2 transition-transform")
    span(class="material-icons text-primary mb-4 text-3xl")
        i(class=icon)
    h4(class="font-bold text-lg my-2")= title
    p(class="text-sm opacity-70 mb-6")= description
    div(class="flex justify-between items-center border-t border-[#cf174533] pt-4")
      span(class="font-bold text-[#CF1745E6]")= price
      a(class="text-xs font-bold uppercase tracking-tighter hover:text-[#CF1745E6]", href="/bookAppointment?service=" + title) Book Now

block content

    //- HERO SECTION
    header(class="relative pb-24 pt-[169px] bg-header-bg")
        div(class="max-w-7xl mx-auto px-6 text-center")
            span(class="text-primary font-bold tracking-[0.4em] uppercase text-xs mb-4 block") Exquisite Care
            h1(class="text-5xl md:text-6xl font-extralight mb-6") Services &amp; 
                span(class="text-5xl md:text-6xl mb-6 font-bold text-primary italic") Pricing
            p(class="max-w-2xl mx-auto text-lg opacity-80 font-light leading-relaxed") Indulge in our curated selection of high-end beauty treatments. Every service is tailored to your unique profile using the world's finest organic products.

            div(class="mt-12 flex justify-center gap-4")
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#hair") Hair Care
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#skin") Skin Therapy
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#nails") Nail Artistry
    
    //- HAIR CARE SECTION
    section(class="py-24 bg-white dark:bg-background-dark/50", id="hair")
        div(class="max-w-7xl mx-auto px-6")
            div(class="flex items-end justify-between mb-16")
                div
                    h2(class="text-3xl font-bold mb-2") Hair Design 
                    div(class="h-1 w-20 bg-[#cf17454d]")

            div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10")
                +hairService("./images/manicure.jpg", "Professional stylist cutting long hair in salon", "85", "Signature Haircut & Styling", "Personalized consultation, luxury wash, precision cut, and professional blowout.", "60")
                +hairService("./images/manicure.jpg", "Model with professional balayage blonde hair highlights", "210", "Bespoke Color Treatment", "Hand-painted highlights for a natural, sun-kissed look. Includes toner and treatment.", "180")
                +hairService("./images/manicure.jpg", "Hair treatment being applied in salon bowl", "185", "Rejuvenating Facial", "Deep reparative treatment to eliminate frizz and restore shine for up to 3 months.", "90")

    //- QUOTE SECTION
    section(class="bg-header-bg py-20")
        div(class="max-w-4xl mx-auto px-6 text-center")
            h3(class="text-2xl font-bold text-[#CF1745E6] mb-4 italic") The E & R Standard
            p(class="text-xl font-light leading-relaxed") "Luxury is not just an appearance, it's the feeling of confidence when you walk out our doors."

    //- SKIN CARE SECTION
    section(class="py-24", id="skin")
        div(class="max-w-7xl mx-auto px-6")
            div(class="flex items-end justify-between mb-16")
                div
                    h2(class="text-3xl font-bold mb-2") Skin Therapy
                    div(class="h-1 w-20 bg-[#cf17454d]")
                p(class="text-sm font-medium opacity-60") Rejuvenating medical-grade facials

            div(class="grid grid-cols-1 md:grid-cols-2 gap-10")
                +skinCard(
                    "./images/manicure.jpg", 
                    "Woman receiving relaxing facial treatment with steam", 
                    "Aesthetic Skin", 
                    "Diamond Glow Facial", 
                    "A transformative 3-in-1 technology that simultaneously exfoliates, extracts, and infuses skin with condition-specific serums.", 
                    "$185"
                )
                +skinCard(
                    "./images/manicure.jpg", 
                    "Detailed view of luxury skincare products", 
                    "Medical Grade", 
                    "Chemical Resurfacing", 
                    "Professional-grade peels designed to target pigmentation, acne, and fine lines. Includes post-care kit and consultation.", 
                    "$150"
                )

    //- NAIL SECTION
    //- Nail Section
    section(class="py-24 bg-[#cf17450d]", id="nails")
        div(class="max-w-7xl mx-auto px-6")
            div(class="text-center mb-16")
                span(class="text-[#CF1745E6] font-bold tracking-[0.4em] uppercase text-xs mb-2 block") The Finishing Touch
                h2(class="text-4xl font-bold mb-4") Nail Artistry
                div(class="h-1 w-24 bg-[#cf1745] mx-auto")

            div(class="grid grid-cols-1 md:grid-cols-4 gap-6")
                +nailCard("fa-solid fa-spa text-[#CF1745E6]", "Classic Manicure", "Cuticle care, nail shaping, massage, and polish.", "$45")
                +nailCard("fa-solid fa-paintbrush text-[#CF1745E6]", "Gel Extensions", "Full set sculpted extensions with chip-resistant gel.", "$85")
                +nailCard("fa-solid fa-star text-[#CF1745E6]", "Signature Pedicure", "Hot stone massage and aromatherapy soak.", "$65")
                +nailCard("fa-solid fa-palette text-[#CF1745E6]", "Custom Nail Art", "Hand-painted designs, foils, and embellishments.", "$20")