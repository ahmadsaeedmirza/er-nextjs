extends base

block content
  main(class="min-h-[60vh] flex items-center justify-center px-6")
    div(class="max-w-xl w-full bg-white border border-slate-200 rounded-xl p-8 text-center shadow-sm")
      h1(class="text-3xl font-bold text-slate-900 mb-3") Something went wrong
      p(class="text-slate-600 mb-6")= msg || 'Please try again later.'
      a(href="/" class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-[#CF1745] text-white font-semibold hover:bg-[#a01138] transition-colors") Go to Home