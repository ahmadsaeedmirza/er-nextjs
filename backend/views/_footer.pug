footer(class="bg-white border-primary/10 pt-24 pb-12")
  div(class="max-w-7xl mx-auto px-6")
    
    //- Main Grid Section
    div(class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-20")
      //- Column 1: Brand
      div(class="col-span-1")
        a(class="text-3xl font-extrabold tracking-tighter text-primary block mb-6", href="#") 
          img(src="/images/logo-3.png", alt="Salon Logo", class="h-20 w-auto")
        p(class="text-slate-500 font-light leading-relaxed") Defining the standards of luxury beauty through exceptional service and artistic innovation since 2012.
    
      //- Column 2: Explore
      div
        h5(class="text-sm font-bold uppercase tracking-widest mb-6") Explore
        ul(class="space-y-4")
          li: a(class="text-slate-500 hover:text-[#CF1745] transition-colors font-light", href="/") Home
          li: a(class="text-slate-500 hover:text-[#CF1745] transition-colors font-light", href="/services") Services
          li: a(class="text-slate-500 hover:text-[#CF1745] transition-colors font-light", href="/products") Our Products
          li: a(class="text-slate-500 hover:text-[#CF1745] transition-colors font-light", href="/bookAppointment") Book Appointment
          li: a(class="text-slate-500 hover:text-[#CF1745] transition-colors font-light", href="/contactUs") Contact Us

      //- Column 3: Visit Us
      div
        h5(class="text-sm font-bold uppercase tracking-widest mb-6") Visit Us
        ul(class="space-y-4 text-slate-500 font-light")
          li(class="flex items-start gap-3")
            i(class="fa-solid fa-location-dot mt-1 text-primary")
            | 124 Madison Avenue<br />New York, NY 10016
          li(class="flex items-center gap-3")
            i(class="fa-solid fa-phone text-primary")
            | +1 (212) 555-0198
          li(class="flex items-center gap-3")
            i(class="fa-regular fa-envelope text-primary")
            | contact@eandrsalon.com
         
      //- Column 4: Hours
      div
        h5(class="text-sm font-bold uppercase tracking-widest mb-6") Hours
        ul(class="space-y-4 text-slate-500 font-light")
          li(class="flex justify-between")
            span Mon -Wed 
            span(class="font-semibold") 09:00 AM - 05:00 PM
          //- li(class="flex justify-between")
          //-   span Tuesday
          //-   span(class="font-semibold") 09:00 AM - 06:30 PM
          //- li(class="flex justify-between")
          //-   span Wednesday
          //-   span(class="font-semibold") 09:00 AM - 06:30 PM
          li(class="flex justify-between")
            span Thursday
            span(class="font-semibold") 09:00 AM - 06:30 PM
          li(class="flex justify-between")
            span Friday 
            span(class="font-semibold") 08:00 AM - 06:30 PM
          li(class="flex justify-between")
            span Saturday 
            span(class="font-semibold") 08:00 AM - 05:00 PM
          li(class="flex justify-between")
            span Sunday
            span(class="font-semibold") 09:00 AM - 02:00 PM

    //- Copyright Section (Moved out of the grid, but inside the main container)
    div(class="border-t border-primary/10 pt-12 flex flex-col md:flex-row items-center justify-between gap-6")
      p(class="text-xs text-slate-400 uppercase tracking-widest") © 2026 E & R Salon. ALL RIGHTS RESERVED. POWERED BY 
        a(href="https://www.linkedin.com/in/ahmad-saeed-057a952a1/", target="_blank" class="underline") Ahmad Saeed
      div(class="flex gap-6")
        a(class="text-slate-400 hover:text-primary transition-colors", href="#")
          i(class="fa-brands fa-facebook")
        a(class="text-slate-400 hover:text-primary transition-colors", href="#")
          i(class="fa-brands fa-instagram")
        a(class="text-slate-400 hover:text-primary transition-colors", href="#")
          i(class="fa-solid fa-at")