extends adminBase

block content

  div(class="min-h-screen flex bg-gray-100 font-display")

    //- // Left Side (Brand Section)
    //- div(class="hidden lg:flex w-1/2 bg-primary text-white items-center justify-center p-12")
    //-   div(class="max-w-md space-y-6")
    //-     h1(class="text-4xl font-bold leading-tight") Welcome Back
    //-     p(class="text-lg opacity-90")
    //-       | Log in to manage your products, orders and analytics from your dashboard.
    //-     div(class="pt-6")
    //-       div(class="h-1 w-20 bg-white rounded")

    // Login Form
    div(class="flex w-full items-center justify-center p-8")
      div(class="w-full max-w-md")
        // Title
        div(class="text-center mb-8")
          h2(class="text-3xl font-bold text-gray-900") Login
          p(class="text-gray-500 mt-2")
            | Enter your credentials to continue

        // Form
        form(id="loginForm" class="space-y-6")
          // Email
          div
            label(class="block text-sm font-medium text-gray-700 mb-2")
              | Email Address
            input(
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
            )

          // Password
          div
            label(class="block text-sm font-medium text-gray-700 mb-2")
              | Password
            div(class="relative")
              input(
                id="password"
                name="password"
                type="password"
                placeholder="Enter your password"
                required
                class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition"
              )

              button(
                type="button"
                onclick="togglePassword()"
                class="absolute right-3 top-3 text-gray-400 cursor-pointer"
              ) 
                i(class="fa-solid fa-eye") 

          // Remember + Forgot
          div(class="flex items-center justify-between text-sm")
            a(class="text-primary font-medium hover:underline" href="#")
              | Forgot password?

          // Login Button
          button(
            id="loginSubmit"
            type="submit"
            class="w-full bg-[#Cf1745] text-white py-3 rounded-lg font-semibold hover:opacity-90 transition"
          ) Sign In

  div(id="toast" class="fixed bottom-6 right-6 z-50 rounded-lg px-4 py-3 text-sm font-semibold text-white opacity-0 transition-opacity duration-300 bg-[#CF1745] pointer-events-none")


  script.
    function togglePassword() {
      const input = document.getElementById("password");
      if (input.type === "password") {
        input.type = "text";
      } else {
        input.type = "password";
      }
    }

block scripts
  script(src='/js/login.js')
