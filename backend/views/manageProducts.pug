extends adminBase

mixin productCard(product)
    //- Product Card Mixin
    - const stockQty = Number(product.stockQuantity) || 0
    div(class="product-card bg-white rounded-xl border border-slate-200 overflow-hidden group hover:shadow-xl hover:shadow-primary/5 transition-all" data-product-card="true" data-search=`${(product.name || '').toLowerCase()} ${(product.slug || '').toLowerCase()}`)
        div(class="relative aspect-[4/3] bg-slate-100 overflow-hidden")
            div(class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-110" style=`background-image: url('/images/products/${product.productImage}')`)
      
            //- Badges
            div(class="absolute top-3 left-3 flex flex-wrap gap-2")
                if stockQty <= 10
                    span(class="bg-amber-500 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider") Low Stock
      
            //- Edit Button
            div(class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity")
                a(href=`/editProduct?id=${product._id}` class="size-8 cursor-pointer bg-white/90 backdrop-blur rounded-full flex items-center justify-center text-slate-900 shadow-lg")
                    span(class="material-symbols-outlined text-lg") 
                        i(class="fa-solid fa-pen-to-square")

        div(class="p-5")
            div(class="flex justify-between items-start mb-2")
                div
                    p(class="text-xs text-slate-400 font-medium mb-1 uppercase tracking-tighter") Slug: #{product.slug}
                    h3(class="font-bold text-lg leading-tight group-hover:text-primary transition-colors") #{product.name}
                p(class="font-black text-lg") $#{product.price.toFixed(2)}
      
            div(class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100")
                div(class="flex items-center gap-2")
                    //- Dot color logic
                    - const dotColor = stockQty <= 10 ? 'bg-amber-500 animate-pulse' : 'bg-emerald-500'
                    div(class=`size-2 rounded-full ${dotColor}`)
                    span(class=`text-sm font-medium ${stockQty <= 10 ? 'text-amber-600' : 'text-slate-600'}`) #{stockQty} in stock
                span(class="text-xs font-bold text-slate-400 bg-slate-50 px-2 py-1 rounded") #{product.discount || 0}% off

block content

    - const safeProducts = Array.isArray(products) ? products : []
    - const lowStockCount = safeProducts.filter((p) => (Number(p.stockQuantity) || 0) <= 10).length
    - const inStockCount = safeProducts.filter((p) => (Number(p.stockQuantity) || 0) > 10).length

    main(class="flex-1 flex flex-col overflow-hidden md:ml-64")
        //- Header
        header(class="h-16 bg-white border-b border-slate-200 px-8 flex items-center justify-between shrink-0")
            div(class="flex items-center gap-4 flex-1")
                div(class="relative w-full max-w-md")
                    span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl") 
                        i(class="fa-solid fa-magnifying-glass")
                    input#manageProductSearch(class="w-full bg-slate-100 border-none rounded-lg pl-10 pr-4 py-2 text-sm focus:ring-2 focus:ring-primary/20" placeholder="Search products by name or slug..." type="text")

            div(class="flex items-center gap-4")
                div(class="h-8 w-[1px] bg-slate-200 mx-2")
                a(href="/editProduct" class="bg-[#CF1745] hover:bg-[#CF17455A] text-white px-4 py-2 rounded-lg text-sm font-bold flex items-center gap-2 shadow-lg shadow-[#CF174514] transition-all active:scale-95")
                    span(class="material-symbols-outlined text-lg") 
                        i(class="fa-solid fa-plus")
                    span Add Product

        //- Scrollable Content
        div(class="flex-1 overflow-y-auto p-8 space-y-8")
            //- Breadcrumbs & Stats
            div(class="flex flex-col lg:flex-row lg:items-end justify-between gap-6")
                div
                    h2(class="text-3xl font-black tracking-tight") Product Inventory
                    p(class="text-slate-500 mt-1") Real-time overview of your store's stock levels and catalog.

                div(class="flex items-center gap-3")
                    each stat in [{label: 'In Stock', val: inStockCount, icon: 'fa-solid fa-check', color: 'emerald'}, {label: 'Low Stock', val: lowStockCount, icon: 'fa-solid fa-triangle-exclamation', color: 'amber'}]
                        div(class="bg-white p-4 rounded-xl border border-slate-200 flex items-center gap-4 shadow-sm min-w-[160px]")
                            div(class=`size-10 rounded-lg bg-${stat.color}-100 text-${stat.color}-600 flex items-center justify-center`)
                                span(class="material-symbols-outlined")
                                    i(class=stat.icon)
                            div
                                p(class="text-xs text-slate-500 font-medium")= stat.label
                                p(class="text-lg font-bold")= stat.val

            //- Filter Buttons
            div(class="flex flex-wrap items-center gap-3")
                button(class="px-4 py-2 text-slate-600 hover:bg-white cursor-pointer rounded-lg text-sm font-medium transition-colors") All Products
                button(class="px-4 py-2 text-slate-600 hover:bg-white cursor-pointer rounded-lg text-sm font-medium transition-colors") Hair Products
                button(class="px-4 py-2 text-slate-600 hover:bg-white cursor-pointer rounded-lg text-sm font-medium transition-colors") Nail Products
                button(class="px-4 py-2 text-slate-600 hover:bg-white cursor-pointer rounded-lg text-sm font-medium transition-colors") Face Products
                button(class="px-4 py-2 text-slate-600 hover:bg-white cursor-pointer rounded-lg text-sm font-medium transition-colors") Low Stocks

            //- Product Grid
            div#productGrid(class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6")
                if products && products.length
                    each item in products
                        +productCard(item)
                else
                    p(class="col-span-full text-slate-500") No products found. Click “Add Product” to create one.

                p#searchEmptyState(class="hidden col-span-full text-slate-500") No products match your search.

                //- Add New Card Skeleton
                a(href="/editProduct" class="bg-[#CF174505] border-2 border-dashed border-[#CF17451E] rounded-xl flex flex-col items-center justify-center p-8 group cursor-pointer hover:bg-[#CF17450A] transition-all hover:border-[#CF1745]")
                    div(class="size-16 rounded-full bg-[#CF174514] flex items-center justify-center text-[#CF1745] group-hover:scale-110 transition-transform mb-4")
                        span(class="material-symbols-outlined text-4xl") 
                            i(class="fa-solid fa-plus")
                    p(class="font-bold text-[#CF1745]") New Product
                    p(class="text-slate-400 text-sm mt-1") Start tracking a new item
                //- div(class="flex items-center justify-between pt-8 border-t border-slate-200")
                //-     p(class="text-sm text-slate-500 font-medium") Showing 1 to 6 of 1,284 products
                //- div(class="flex items-center gap-2")
                //-     button(class="size-10 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")
                //-         span(class="material-symbols-outlined") chevron_left
                //-     each page in [1, 2, 3]
                //-         button(class=`size-10 flex items-center justify-center rounded-lg ${page === 1 ? 'bg-primary text-white font-bold' : 'border border-slate-200 bg-white text-slate-600 hover:bg-slate-50'}`)= page
                //-     button(class="size-10 flex items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50")
                //-         span(class="material-symbols-outlined") chevron_right

block scripts
    script.
        (function () {
            const searchInput = document.getElementById('manageProductSearch');
            const productCards = Array.from(document.querySelectorAll('[data-product-card="true"]'));
            const emptyState = document.getElementById('searchEmptyState');

            if (!searchInput || !productCards.length) return;

            const applyFilter = function () {
                const query = (searchInput.value || '').trim().toLowerCase();
                let visibleCount = 0;

                productCards.forEach(function (card) {
                    const searchableText = (card.getAttribute('data-search') || '').toLowerCase();
                    const matches = !query || searchableText.includes(query);
                    card.classList.toggle('hidden', !matches);
                    if (matches) visibleCount += 1;
                });

                if (emptyState) {
                    emptyState.classList.toggle('hidden', visibleCount > 0);
                }
            };

            searchInput.addEventListener('input', applyFilter);
        })();