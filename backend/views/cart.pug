extends base

//- Mixin to render individual cart items
mixin cartItem(item)
    div(class="cart-item grid grid-cols-1 md:grid-cols-12 items-center border-b py-6 gap-4", data-product-id=item.productId, data-price=item.price)
        div(class="col-span-6 flex gap-4")
            img(src=`/images/products/${item.image}`, class="w-20 h-20 object-cover rounded-md")
            div
                h3(class="font-bold text-lg")= item.name
                p(class="text-sm font-semibold text-[#CF1745E6]") 2 to 5 Business Days
                p(class="text-xs text-gray-400 mt-1")= item.detail

            div(class="grid place-items-center w-2/4 cursor-pointer delete-item", data-product-id=item.productId)
                i(class="fa-solid text-xl hover:text-[#CF1745] fa-trash-can")
    
        div(class="md:col-span-2 text-right font-medium item-price")= `$${Number(item.price).toFixed(2)}`
    
        div(class="md:col-span-2 flex justify-center")
            div(class="flex items-center border border-gray-300 rounded")
                button(class="qty-decrease px-3 py-1 hover:bg-gray-100") −
                span(class="qty-value px-4 text-sm")= item.quantity
                button(class="qty-increase px-3 py-1 hover:bg-gray-100") +
    
        div(class="md:col-span-2 text-right font-bold item-total")= `$${(Number(item.price) * item.quantity).toFixed(2)}`

block content
    main(class="max-w-5xl mx-auto px-6 py-12")
        h1(class="text-3xl font-bold mb-10") Your Cart

        //- Table Header
        div(class="hidden md:grid grid-cols-12 text-sm text-gray-500 uppercase border-b pb-4 mb-2")
            div(class="col-span-6") Item
            div(class="col-span-2 text-right") Price
            div(class="col-span-2 text-center") Quantity
            div(class="col-span-2 text-right") Total

        //- Check if items exist before looping
        if cartItems && cartItems.length > 0
            each item in cartItems
                +cartItem(item)
        else
            p(class="py-10 text-center text-gray-500") Your cart is empty.

        //- Checkout & Shipping Form Section
        div(class="flex flex-col lg:flex-row mt-12 gap-12")
      
            //- Shipping Address Form
            div(class="flex-1 bg-[#E7E5E4/60] shadow-2xl rounded-xl p-16")
                h2(class="text-xl font-bold mb-6") Shipping Information
                form(class="grid grid-cols-1 md:grid-cols-2 gap-4")
                    div(class="md:col-span-2")
                        label(class="block text-sm text-stone-400 font-medium mb-1") Full Name
                        input(type="text" class="w-full border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all" required)
                    div(class="md:col-span-2")
