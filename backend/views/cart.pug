                    div(class="md:col-span-2")
                        input(type="text" class="w-full border border-stone-200 rounded-lg px-4 py-4 text-sm focus:ring-1 focus:ring-[#CF1745] focus:border-[#CF1745] transition-all" placeholder="Apartment, suite, etc. (optional)")
