                        span(id="grand-total") $0.00

                    button(class="w-full mt-6 bg-[#CF1745E6] text-white py-4 font-bold uppercase rounded-lg tracking-widest hover:scale-105 transition-transform cursor-pointer")
                        | Place Order

block scripts
    script.
        const TAX_RATE = 0.10; // 10% tax rate

        function calculateTotals() {
            let subtotal = 0;
            // Only target cart-item rows, not delete buttons
            document.querySelectorAll(".cart-item").forEach(row => {
                const price = parseFloat(row.getAttribute("data-price"));
                const quantity = parseInt(row.querySelector(".qty-value").innerText);
                const itemTotal = price * quantity;
                
                // Update item total
                row.querySelector(".item-total").innerText = `$${itemTotal.toFixed(2)}`;
                subtotal += itemTotal;
            });

            const tax = subtotal * TAX_RATE;
            const grandTotal = subtotal + tax;

            document.getElementById("subtotal").innerText = `$${subtotal.toFixed(2)}`;
            document.getElementById("tax").innerText = `$${tax.toFixed(2)}`;
            document.getElementById("grand-total").innerText = `$${grandTotal.toFixed(2)}`;
        }

        // Add event listeners to quantity buttons
        document.querySelectorAll(".qty-increase").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const qtySpan = btn.parentElement.querySelector(".qty-value");
                qtySpan.innerText = parseInt(qtySpan.innerText) + 1;
                calculateTotals();
            });
        });

        document.querySelectorAll(".qty-decrease").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const qtySpan = btn.parentElement.querySelector(".qty-value");
                const currentQty = parseInt(qtySpan.innerText);
                if (currentQty > 1) {
                    qtySpan.innerText = currentQty - 1;
                    calculateTotals();
                }
            });
        });

        // Calculate totals on page load
        calculateTotals();

        // Delete item functionality
        document.querySelectorAll(".delete-item").forEach(deleteBtn => {
          deleteBtn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productId = deleteBtn.getAttribute("data-product-id");
            console.log("Attempting to delete product:", productId);
            
            if (!productId) {
              console.error("No productId found");
              return;
            }
            
            try {
              const response = await axios.post("/api/cart/remove", { productId: productId });
              console.log("Delete response:", response.data);
              
              // Show success toast
              const toast = document.getElementById("toast");
              toast.innerText = "Item removed from cart";
              toast.classList.remove("bg-red-600", "opacity-0");
              toast.classList.add("bg-[#CF1745]", "opacity-100");
              
              setTimeout(() => {
                location.reload();
              }, 1000);
            } catch (err) {
              console.error("Error removing cart item:", err.response?.data || err.message);
              
              // Show error toast
              const toast = document.getElementById("toast");
              toast.innerText = "Failed to remove item";
              toast.classList.remove("bg-[#CF1745]", "opacity-0");
              toast.classList.add("bg-red-600", "opacity-100");
              
              setTimeout(() => {
                toast.classList.remove("opacity-100");
                toast.classList.add("opacity-0");
              }, 3000);
            }
          });
        });