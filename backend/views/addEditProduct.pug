extends adminBase

block content

    main(class="flex-1 overflow-y-auto md:ml-64")

        div(class="max-w-4xl mx-auto p-8")

            //- Page Header
            div(class="mb-8 flex items-center justify-between")
                div
                    h2(class="text-3xl font-bold text-slate-900")= product ? 'Edit Product' : 'Add New Product'
                    p(class="text-slate-500 mt-1")= product ? 'Update product details, media, and stock levels.' : 'Fill in the details to add a new product to your catalog.'
                a(href="/manageProducts" class="flex items-center gap-2 text-sm text-slate-500 hover:text-slate-800 transition-colors")
                    i(class="fa-solid fa-arrow-left text-xs")
                    | Back to Products

            //- Form (General Info FIRST so name field is parsed before the file by multer)
            form#productForm(class="space-y-8")

                //- General Information Section
                section(class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm")
                    h3(class="text-lg font-semibold mb-6 text-slate-900") General Information
                    div(class="grid grid-cols-1 md:grid-cols-2 gap-6")

                        div(class="md:col-span-2")
                            label(class="block text-sm font-semibold text-slate-700 mb-2") Product Name
                            input#nameInput(
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 focus:ring-2 focus:ring-[#CF174514] focus:border-[#CF1745] outline-none transition-all"
                                type="text"
                                name="name"
                                placeholder="Enter product name"
                                value=product ? product.name : '')

                        div(class="md:col-span-2")
                            label(class="block text-sm font-semibold text-slate-700 mb-2") Description
                            textarea(
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 focus:ring-2 focus:ring-[#CF174514] focus:border-[#CF1745] outline-none transition-all resize-none"
                                name="description"
                                rows="4"
                                placeholder="Enter product description")= product ? product.description : ''

                        div
                            label(class="block text-sm font-semibold text-slate-700 mb-2") Price ($)
                            input(
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 focus:ring-2 focus:ring-[#CF174514] focus:border-[#CF1745] outline-none transition-all"
                                type="number"
                                step="0.01"
                                min="0"
                                name="price"
                                placeholder="0.00"
                                value=product ? product.price : '')

                        div
                            label(class="block text-sm font-semibold text-slate-700 mb-2") Discount (%)
                            input(
                                class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 focus:ring-2 focus:ring-[#CF174514] focus:border-[#CF1745] outline-none transition-all"
                                type="number"
                                min="0"
                                max="100"
                                name="discount"
                                placeholder="0"
                                value=product ? product.discount : 0)

                        div
                            label(class="block text-sm font-semibold text-slate-700 mb-2") Stock Quantity
                            div(class="flex items-center border border-slate-200 rounded-lg overflow-hidden bg-white")
                                button(type="button" id="decrementBtn" class="px-4 py-3 text-slate-500 hover:bg-slate-50 transition-colors")
                                    i(class="fa-solid fa-minus")
                                input#stockInput(
                                    class="flex-1 w-full text-center border-none bg-transparent text-slate-900 focus:ring-0 outline-none"
                                    type="number"
                                    min="0"
                                    name="stockQuantity"
                                    value=product ? product.stockQuantity : 0)
                                button(type="button" id="incrementBtn" class="px-4 py-3 text-slate-500 hover:bg-slate-50 transition-colors")
                                    i(class="fa-solid fa-plus")

                //- Product Image Section
                section(class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm")
                    h3(class="text-lg font-semibold mb-4 text-slate-900") Product Image
                    div(class="relative group cursor-pointer" id="imageDropZone")
                        div(class="w-full aspect-[21/9] bg-slate-100 rounded-lg overflow-hidden border-2 border-dashed border-slate-300 flex flex-col items-center justify-center hover:border-[#CF1745] transition-all relative")

                            //- Existing / new preview
                            if product && product.productImage
                                div#imagePreview(class="absolute inset-0 bg-cover bg-center" style=`background-image: url('/images/products/${product.productImage}')`)
                            else
                                div#imagePreview(class="hidden absolute inset-0 bg-cover bg-center")

                            //- Hover overlay
                            div(class="absolute inset-0 z-10 bg-black/40 backdrop-blur-sm flex flex-col items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity")
                                i(class="fa-solid fa-cloud-arrow-up text-4xl mb-2")
                                p(class="font-medium") Click to upload image
                                p(class="text-xs opacity-80 mt-1") PNG, JPG or WEBP • Max 5MB

                            //- Default placeholder (hidden once image is selected)
                            div#defaultIcon(class=`relative z-0 flex flex-col items-center text-slate-400 ${product && product.productImage ? 'hidden' : ''}`)
                                i(class="fa-solid fa-image text-5xl")
                                p(class="text-sm mt-3") Click to upload an image

                    input#productImageInput(type="file" name="productImage" accept="image/*" class="hidden")

                //- Action Buttons
                div(class="flex items-center justify-between gap-4 py-4")
                    if product
                        div(class="flex items-center gap-3")
                            button(type="button" id="toggleVisibilityBtn" data-hidden=product.isHidden ? 'true' : 'false' class="px-5 py-3 rounded-lg border border-amber-300 text-amber-700 font-semibold hover:bg-amber-50 transition-colors cursor-pointer")= product.isHidden ? 'List Product' : 'Delist Product'
                            button(type="button" id="deleteProductBtn" class="px-5 py-3 rounded-lg border border-red-300 text-red-700 font-semibold hover:bg-red-50 transition-colors cursor-pointer") Delete Product
                    else
                        div

                    div(class="flex items-center gap-4")
                        a(href="/manageProducts" class="px-6 py-3 rounded-lg text-slate-600 font-semibold hover:bg-slate-100 transition-colors cursor-pointer") Discard
                        button(type="submit" id="submitBtn" class="px-8 py-3 bg-[#CF1745] hover:bg-[#a01035] text-white rounded-lg cursor-pointer font-bold shadow-lg shadow-[#CF174514] transition-all flex items-center gap-2")
                            i(class="fa-solid fa-floppy-disk")
                            span#submitBtnText= product ? 'Save Changes' : 'Add Product'

            //- Feedback message
            div#msgBox(class="hidden mt-4 p-4 rounded-lg text-sm font-medium")

            if product
                //- Verify identity popup (for hide/delete)
                div#verifyModal(class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-4")
                    div(class="w-full max-w-md bg-white rounded-xl border border-slate-200 shadow-2xl p-6")
                        h3(class="text-xl font-bold text-slate-900 mb-2") Verify Identity
                        p(class="text-sm text-slate-600 mb-1") Please confirm your password to continue.
                        p(class="text-sm text-slate-700 mb-4") Logged in as: 
                            span(class="font-semibold") #{adminEmail}

                        p#verifyActionText(class="text-sm font-semibold text-slate-700 mb-2")
                        input#verifyPasswordInput(type="password" class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white text-slate-900 focus:ring-2 focus:ring-[#CF174514] focus:border-[#CF1745] outline-none transition-all" placeholder="Enter your password")
                        p#verifyError(class="hidden text-sm text-red-600 mt-2") Password verification failed.

                        div(class="flex items-center justify-end gap-3 mt-6")
                            button(type="button" id="cancelVerifyBtn" class="px-4 py-2 rounded-lg text-slate-600 font-semibold hover:bg-slate-100 transition-colors") Cancel
                            button(type="button" id="confirmVerifyBtn" class="px-5 py-2 rounded-lg bg-[#CF1745] text-white font-semibold hover:bg-[#a01035] transition-colors") Confirm

    script.
        const isEditing = !{JSON.stringify(!!product)};
        const productId = !{JSON.stringify(product ? String(product._id) : null)};
        const adminEmail = !{JSON.stringify(adminEmail || '')};
        const initialHidden = !{JSON.stringify(product ? !!product.isHidden : false)};

        // --- Image preview ---
        const imageDropZone = document.getElementById('imageDropZone');
        const imageInput    = document.getElementById('productImageInput');
        const imagePreview  = document.getElementById('imagePreview');
        const defaultIcon   = document.getElementById('defaultIcon');

        imageDropZone.addEventListener('click', function () { imageInput.click(); });

        imageInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                imagePreview.style.backgroundImage = "url('" + e.target.result + "')";
                imagePreview.classList.remove('hidden');
                defaultIcon.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        });

        // --- Stock +/- ---
        document.getElementById('incrementBtn').addEventListener('click', function () {
            const el = document.getElementById('stockInput');
            el.value = (parseInt(el.value) || 0) + 1;
        });
        document.getElementById('decrementBtn').addEventListener('click', function () {
            const el = document.getElementById('stockInput');
            el.value = Math.max(0, (parseInt(el.value) || 0) - 1);
        });

        // --- Form submit ---
        document.getElementById('productForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const msgBox    = document.getElementById('msgBox');
            const submitBtn = document.getElementById('submitBtn');
            const btnText   = document.getElementById('submitBtnText');

            submitBtn.disabled = true;
            btnText.textContent = isEditing ? 'Saving...' : 'Adding...';

            const formData = new FormData(e.target);
            const url    = isEditing ? '/api/v1/products/' + productId : '/api/v1/products';
            const method = isEditing ? 'PATCH' : 'POST';

            try {
                const res  = await fetch(url, { method: method, body: formData });
                const data = await res.json();

                if (data.status === 'success') {
                    msgBox.textContent  = isEditing ? 'Product updated successfully!' : 'Product added successfully!';
                    msgBox.className    = 'mt-4 p-4 rounded-lg text-sm font-medium bg-green-100 text-green-800';
                    setTimeout(function () { window.location.href = '/manageProducts'; }, 1500);
                } else {
                    msgBox.textContent  = data.message || 'Something went wrong.';
                    msgBox.className    = 'mt-4 p-4 rounded-lg text-sm font-medium bg-red-100 text-red-800';
                    submitBtn.disabled  = false;
                    btnText.textContent = isEditing ? 'Save Changes' : 'Add Product';
                }
            } catch (err) {
                msgBox.textContent  = 'Network error. Please try again.';
                msgBox.className    = 'mt-4 p-4 rounded-lg text-sm font-medium bg-red-100 text-red-800';
                submitBtn.disabled  = false;
                btnText.textContent = isEditing ? 'Save Changes' : 'Add Product';
            }
        });

        // --- Verify popup for hide/delete ---
        if (isEditing) {
            const verifyModal = document.getElementById('verifyModal');
            const verifyPasswordInput = document.getElementById('verifyPasswordInput');
            const verifyError = document.getElementById('verifyError');
            const verifyActionText = document.getElementById('verifyActionText');
            const confirmVerifyBtn = document.getElementById('confirmVerifyBtn');
            const cancelVerifyBtn = document.getElementById('cancelVerifyBtn');
            const toggleVisibilityBtn = document.getElementById('toggleVisibilityBtn');
            const deleteProductBtn = document.getElementById('deleteProductBtn');
            const msgBox = document.getElementById('msgBox');

            let pendingAction = null;

            function openVerifyModal(action) {
                pendingAction = action;
                verifyPasswordInput.value = '';
                verifyError.classList.add('hidden');
                verifyActionText.textContent = action === 'delete'
                    ? 'You are about to delete this product permanently.'
                    : (toggleVisibilityBtn.dataset.hidden === 'true'
                        ? 'You are about to show this product on the website.'
                        : 'You are about to hide this product from the website.');
                verifyModal.classList.remove('hidden');
                verifyModal.classList.add('flex');
                setTimeout(function () { verifyPasswordInput.focus(); }, 0);
            }

            function closeVerifyModal() {
                verifyModal.classList.add('hidden');
                verifyModal.classList.remove('flex');
                pendingAction = null;
            }

            async function verifyIdentity(password) {
                const res = await fetch('/api/v1/admin/verifyPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: password })
                });
                const data = await res.json();
                return { ok: data.status === 'success', data: data };
            }

            async function runPendingAction() {
                if (pendingAction === 'delete') {
                    const res = await fetch('/api/v1/products/' + productId, { method: 'DELETE' });
                    if (res.status === 204) {
                        msgBox.textContent = 'Product deleted successfully!';
                        msgBox.className = 'mt-4 p-4 rounded-lg text-sm font-medium bg-green-100 text-green-800';
                        setTimeout(function () { window.location.href = '/manageProducts'; }, 1000);
                        return;
                    }
                    const data = await res.json();
                    throw new Error(data.message || 'Delete failed');
                }

                const currentlyHidden = toggleVisibilityBtn.dataset.hidden === 'true';
                const nextHiddenState = !currentlyHidden;
                const res = await fetch('/api/v1/products/' + productId + '/visibility', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isHidden: nextHiddenState })
                });
                const data = await res.json();
                if (data.status !== 'success') {
                    throw new Error(data.message || 'Visibility update failed');
                }

                toggleVisibilityBtn.dataset.hidden = String(nextHiddenState);
                toggleVisibilityBtn.textContent = nextHiddenState ? 'Show on Website' : 'Hide from Website';
                msgBox.textContent = nextHiddenState ? 'Product hidden from website.' : 'Product is now visible on website.';
                msgBox.className = 'mt-4 p-4 rounded-lg text-sm font-medium bg-green-100 text-green-800';
            }

            toggleVisibilityBtn.dataset.hidden = String(initialHidden);

            toggleVisibilityBtn.addEventListener('click', function () {
                openVerifyModal('hide');
            });

            deleteProductBtn.addEventListener('click', function () {
                openVerifyModal('delete');
            });

            cancelVerifyBtn.addEventListener('click', function () {
                closeVerifyModal();
            });

            verifyModal.addEventListener('click', function (e) {
                if (e.target === verifyModal) closeVerifyModal();
            });

            confirmVerifyBtn.addEventListener('click', async function () {
                const password = verifyPasswordInput.value.trim();
                if (!password) {
                    verifyError.textContent = 'Please enter your password.';
                    verifyError.classList.remove('hidden');
                    return;
                }

                confirmVerifyBtn.disabled = true;
                confirmVerifyBtn.textContent = 'Verifying...';

                try {
                    const verification = await verifyIdentity(password);
                    if (!verification.ok) {
                        verifyError.textContent = verification.data.message || 'Password verification failed.';
                        verifyError.classList.remove('hidden');
                        confirmVerifyBtn.disabled = false;
                        confirmVerifyBtn.textContent = 'Confirm';
                        return;
                    }

                    await runPendingAction();
                    closeVerifyModal();
                } catch (err) {
                    verifyError.textContent = err.message || 'Something went wrong.';
                    verifyError.classList.remove('hidden');
                } finally {
                    confirmVerifyBtn.disabled = false;
                    confirmVerifyBtn.textContent = 'Confirm';
                }
            });
        }