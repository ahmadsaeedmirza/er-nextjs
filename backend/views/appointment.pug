extends base

block content
    main(class="bg-header-bg")
        div(class="max-w-7xl mx-auto px-6 pt-[169px] pb-24")
            div(class="flex flex-col lg:flex-row gap-8 items-stretch")

                //- Left Column: Real Calendar Container
                div(class="lg:w-7/12 bg-white/60 -xl p-8 shadow-sm rounded-xl backdrop-blur-md")
                    div(class="flex items-center justify-between mb-8")
                        div
                            h1(class="text-3xl font-light tracking-tight")
                                | Select your 
                                span(class="font-bold text-[#cf1745]") Preferred Date
                            p(class="text-slate-500 mt-1") Available slots for Hair, Nails, and Spa treatments.

                        //- Calendar Navigation
                        div(class="flex space-x-2")
                            button#prevMonth(class="p-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] text-[#cf1745]")
                                span(class="material-icons text-sm") 
                                    i(class="fa-solid fa-chevron-left")
                            button#nextMonth(class="p-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] text-[#cf1745]")
                                span(class="material-icons text-sm") 
                                    i(class="fa-solid fa-chevron-right")

                    div(class="mb-6")
                        h2#monthDisplay(class="text-lg font-semibold mb-4 text-center uppercase tracking-widest") October 2023
                        .calendar-grid(class="grid grid-cols-7 text-center text-xs font-bold text-slate-400 mb-4 tracking-tighter")
                            each day in ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT']
                                span= day

                        //- This is where the JavaScript will inject the days
                        div#calendarDays(class="grid grid-cols-7 gap-2")

                    div(class="mt-8 pt-8 border-t border-[#cf17451A]")
                        h3(class="text-sm font-bold uppercase tracking-widest mb-4") Select Time
                        div#timeSlots(class="grid grid-cols-4 gap-3")
                            //- <div class="mt-8 pt-8 border-t border-primary/10">
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 08:00 AM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 09:00 AM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 10:00 AM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 11:00 AM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 12:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 01:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 02:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 03:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 04:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 05:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 06:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 07:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 08:00 PM
                            button(class="py-3 px-4 rounded-lg border border-[#CF17451A] bg-white/40 cursor-pointer hover:border-[#CF1745] transition-all text-sm") 09:00 PM

                //- Right Column: Booking Form
                div(class="lg:w-5/12 flex flex-col")
                    div(class="flex-grow bg-white rounded-xl shadow-xl border border-[#cf17451A] p-8 relative overflow-hidden")
                        div(class="absolute -top-12 -right-12 w-48 h-48 bg-primary\/5 rounded-full blur-3xl")
                        div(class="relative z-10")
                            div(class="mb-8")
                                h2(class="text-2xl font-bold tracking-tight")
                                    | Reserve Your 
                                    span(class="text-[#cf1745] italic") Experience
                                p(class="text-slate-400 text-sm mt-1") Fill in your details to secure your artisan.

                            form(class="space-y-6")
                                div(class="space-y-1")
                                    label(class="text-xs font-bold uppercase tracking-widest text-slate-400") Full Name
                                    div(class="relative")
                                        input(class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-[#CF1745] transition-all", placeholder="Your Name", type="text")
              
                                div(class="grid grid-cols-2 gap-4")
                                    div(class="space-y-1")
                                        label(class="text-xs font-bold uppercase tracking-widest text-slate-400") Phone
                                        input(class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-[#cf1745] transition-all", placeholder="+1 (555) 000-0000", type="tel")
                                    div(class="space-y-1")
                                        label(class="text-xs font-bold uppercase tracking-widest text-slate-400") Email
                                        input(class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-[#cf1745] transition-all", placeholder="e&r@luxury.com", type="email")

                                div(class="space-y-1")
                                    label(class="text-xs font-bold uppercase tracking-widest text-slate-400") Service Category
                                    select(id="serviceSelect", class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#CF1745] focus:border-transparent outline-none transition-all appearance-none")
                                        option(selected= selectedService === 'Signature Haircut & Styling') Signature Haircut &amp; Styling
                                        option(selected= selectedService === 'Bespoke Color Treatment') Bespoke Color Treatment
                                        option(selected= selectedService === 'Rejuvenating Facial') Rejuvenating Facial
                                        option(selected= selectedService === 'Deep Tissue Stone Massage') Deep Tissue Stone Massage
                                        option(selected= selectedService === 'Deluxe Manicure & Pedicure') Deluxe Manicure &amp; Pedicure
                                        option(selected= selectedService === 'Classic Manicure') Classic Manicure
                                        option(selected= selectedService === 'Gel Extensions') Gel Extensions
                                        option(selected= selectedService === 'Signature Pedicure') Signature Pedicure
                                        option(selected= selectedService === 'Custom Nail Art') Custom Nail Art
                                        option(selected= selectedService === 'Chemical Resurfacing') Chemical Resurfacing
                                        option(selected= selectedService === 'Diamond Glow Facial') Diamond Glow Facial

                                div(class="bg-[#CF17450D] rounded-xl p-4 border border-[#CF17451A]")
                                    h4(class="text-xs font-bold uppercase tracking-widest text-[#Cf1745] mb-2") Selection Summary
                                    div(class="flex justify-between items-center text-sm")
                                        div
                                            p(class="font-bold", id="selectedDate") Select a date
                                            p(class="text-slate-500", id="selectedTime") Select a time
                                        div(class="text-right")
                                            p(class="font-bold", id="selectedService") Select a service
                                            p(class="text-primary font-bold", id="selectedPrice") $0.00

                                button(class="w-full cursor-pointer bg-[#cf1745] hover:bg-[#cf1745E6] text-white font-bold py-4 rounded-lg shadow-xl transition-all flex items-center justify-center space-x-2", type="button")
                                    span(class="uppercase tracking-widest") Confirm Appointment
                                        i(class="fa-solid fa-arrow-right pl-2")

block scripts
    script.
        const servicePrices = {
            "Signature Haircut & Styling": 85,
            "Bespoke Color Treatment": 210,
            "Rejuvenating Facial": 185,
            "Deep Tissue Stone Massage": 220,
            "Deluxe Manicure & Pedicure": 150,
            "Classic Manicure": 45,
            "Gel Extensions": 85,
            "Signature Pedicure": 65,
            "Custom Nail Art": 20,
            "Chemical Resurfacing": 150,
            "Diamond Glow Facial": 185
        };
    script(src="/js/calender.js")
    script(src="/js/appointment.js")