mixin productCard(product)
  div(class="group")
    a(href=`/products/${product.slug}`)
        div(class="relative aspect-[4/5] bg-white mb-6 overflow-hidden rounded-lg")
            img(class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105", src=`/images/products/${product.productImage}`, alt=product.name)
            if product.stockQuantity === 0
                div(class="absolute top-4 right-4 bg-red-500 text-white text-[10px] font-bold px-3 py-1 uppercase tracking-widest") Out of Stock
    div(class="text-center space-y-4")
      h3(class="text-sm font-bold uppercase tracking-widest mb-1 text-slate-900")= product.name
      p(class="text-[#CF1745] font-mono")= `$${Number(product.price).toFixed(2)}`
      if product.stockQuantity === 0
        button(
          class="bg-gray-400 text-white px-6 py-3 rounded-full text-[12px] font-semibold uppercase ... w-full cursor-not-allowed"
          disabled
        ) Add to Cart
      else
        button(
          class="add-to-cart-btn bg-[#CF1745] text-white cursor-pointer hover:scale-105 px-6 py-3 rounded-full text-[12px] font-semibold uppercase ... w-full"
          data-id=product.id,
          data-name=product.name,
          data-price=product.price,
          data-image=product.productImage,
          data-detail=product.description,
          data-stock=product.stockQuantity
        ) Add to Cart

block content 
    section(class="relative pb-24 pt-[169px] flex items-center justify-center overflow-hidden bg-header-bg")
        div(class="text-center z-10") 
            span(class="text-primary font-bold tracking-[0.4em] uppercase text-xs mb-4 block") EXCLUXIVE SELECTION
            //- h1(class="text-4xl md:text-5xl tracking-tight mb-6") Signature Collection
            h1(class="text-5xl md:text-6xl font-bold italic mb-6") Signature 
                span(class="text-5xl md:text-6xl mb-6 font-extralight text-primary") Collection
            p(class="max-w-lg mx-auto font-light text-lg italic") Elevate your daily beauty ritual with our hand-selected range of premium, high-performance essentials.
            div(class="mt-12 flex justify-center gap-4")
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#hairCare") Hair Care
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#skinCare") Skin Care
                a(class="px-6 py-2 rounded-full border border-[#cf174533] hover:bg-[#cf17451A] transition-colors text-sm font-medium", href="#nailCare") Nail Care

    main(class="bg-[#F8F6F6]")
        div(class="max-w-7xl mx-auto px-6 py-24")
            div(class="flex flex-col md:flex-row gap-8")
                // Sidebar Filters
                aside(class="w-full md:w-64 space-y-8")
                  div
                    h3(class="text-xs uppercase tracking-[0.2em] font-bold text-[#CF1745E6] mb-6") Categories
                    ul(class="space-y-4 text-sm text-slate-600 dark:text-slate-400")
                        li(class="flex justify-between items-center group cursor-pointer")
                            span(class="group-hover:text-[#CF1745E6] transition-colors font-medium") Hair Care
                            span(class="text-[10px] opacity-50") 12
                        li(class="flex justify-between items-center group cursor-pointer")
                            span(class="group-hover:text-[#CF1745E6] transition-colors font-medium") Styling & Finish
                            span(class="text-[10px] opacity-50") 08
                        li(class="flex justify-between items-center group cursor-pointer")
                            span(class="group-hover:text-[#CF1745E6] transition-colors font-medium") Treatments
                            span(class="text-[10px] opacity-50") 05
                        li(class="flex justify-between items-center group cursor-pointer")
                            span(class="group-hover:text-[#CF1745E6] transition-colors font-medium") Tools
                            span(class="text-[10px] opacity-50") 03

                //- Usage in your grid
                div(class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5")
                    each product in products
                        //- +productCard(product.name, product.price, product.description, `/images/products/${product.productImage}`)
                        +productCard(product)
block scripts
    script(src="/js/cart.js")