extends adminBase

block content
    main(class="flex-1 flex flex-col overflow-hidden md:ml-64")
        header(class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shrink-0")
            div(class="flex items-center gap-4")
                h2(class="text-lg font-bold") Manage Orders

        div(class="flex-1 overflow-y-auto p-8")
            div(class="max-w-6xl mx-auto space-y-6")
                div(class="flex flex-col md:flex-row md:items-end justify-between gap-4")
                    h1(class="text-3xl font-black text-slate-900 pb-4 tracking-tight") Orders Overview
                    button(id="reloadOrders" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-white")
                        i(class="fa-solid fa-rotate-right")
                        | Refresh

            div(class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col gap-4 my-4")
                div(class="flex flex-col md:flex-row gap-4 items-center")
                    div(class="relative flex-1 w-full")
                        span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400")
                            i(class="fa-solid fa-magnifying-glass")
                        input(id="orderSearch" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border-none rounded-lg text-sm focus:ring-2 focus:ring-primary/20 placeholder:text-slate-400 transition-all" placeholder="Search by Order ID, customer or product..." type="search")
                    div(id="orderStatusFilters" class="flex items-center bg-slate-50 rounded-lg p-1 shrink-0")
                        each filter in [{label:'All', value:'all', active:true}, {label:'Pending', value:'Pending', active:false}, {label:'Shipped', value:'Shipped', active:false}]
                            button(type="button" data-order-status=filter.value class=`px-4 py-1.5 text-sm rounded-md transition-colors ${filter.active ? 'font-bold bg-white shadow-sm text-slate-900' : 'font-medium text-slate-500 hover:text-slate-900'}`)= filter.label

            div(class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden")
                div(class="overflow-x-auto")
                    table(class="w-full text-left border-collapse")
                        thead
                            tr(class="bg-slate-50 border-b border-slate-200")
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider") Order ID
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider") Customer Name
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider") Items
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider") Price
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider") Status
                                th(class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right") Order Details
                        tbody(id="ordersTableBody" class="divide-y divide-slate-100")
                            tr
                                td(colspan="6" class="px-6 py-10 text-center text-slate-500") Loading orders...

                div(class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col gap-3 md:flex-row md:items-center md:justify-between")
                    p(id="ordersPaginationSummary" class="text-sm text-slate-500") Loading orders...
                    div(class="flex items-center gap-2")
                        button(id="ordersPrevPage" type="button" class="p-2 border border-slate-200 rounded hover:bg-white transition-colors disabled:opacity-50")
                            span(class="material-symbols-outlined text-[18px]")
                                i(class="fa-solid fa-chevron-left")
                        div(id="ordersPaginationNumbers" class="flex items-center gap-2")
                        button(id="ordersNextPage" type="button" class="p-2 border border-slate-200 rounded hover:bg-white transition-colors disabled:opacity-50")
                            span(class="material-symbols-outlined text-[18px]")
                                i(class="fa-solid fa-chevron-right")

    div(id="toast" class="fixed bottom-6 right-6 z-50 rounded-lg px-4 py-3 text-sm font-semibold text-white opacity-0 transition-opacity duration-300 bg-[#CF1745] pointer-events-none")

block scripts
    script(src='/js/manageOrders.js')