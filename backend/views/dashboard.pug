extends adminBase

block content
    main(class="flex-1 flex flex-col overflow-hidden md:ml-64")
        header(class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-8 shrink-0")
            div(class="flex items-center gap-4")
                h2(class="text-xl font-bold text-slate-900") Dashboard

            button(id="refreshDashboard" type="button" class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-white")
                i(class="fa-solid fa-rotate-right")
                | Refresh

        div(class="flex-1 overflow-y-auto p-8")
            div(class="max-w-7xl mx-auto space-y-6")
                div
                    h1(class="text-3xl font-black text-slate-900 tracking-tight") Business Overview
                    p(class="text-sm text-slate-500 mt-1") Live snapshot of sales, orders, appointments, and performance trends.

                div(id="dashboardLoading" class="bg-white border border-slate-200 rounded-xl p-6 text-slate-500") Loading dashboard data...

                div(id="dashboardContent" class="hidden space-y-6")
                    div(class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4")
                        div(class="bg-white rounded-xl border border-slate-200 p-5")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-500") Total Sales
                            p(id="metricTotalSales" class="text-2xl font-black text-slate-900 mt-2") $0.00
                        div(class="bg-white rounded-xl border border-slate-200 p-5")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-500") Total Orders
                            p(id="metricTotalOrders" class="text-2xl font-black text-slate-900 mt-2") 0
                        div(class="bg-white rounded-xl border border-slate-200 p-5")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-500") Pending Orders
                            p(id="metricPendingOrders" class="text-2xl font-black text-slate-900 mt-2") 0
                        div(class="bg-white rounded-xl border border-slate-200 p-5")
                            p(class="text-xs font-semibold uppercase tracking-wider text-slate-500") Total Appointments
                            p(id="metricTotalAppointments" class="text-2xl font-black text-slate-900 mt-2") 0

                    div(class="grid grid-cols-1 xl:grid-cols-3 gap-4")
                        div(class="xl:col-span-2 bg-white rounded-xl border border-slate-200 p-5")
                            div(class="flex items-center justify-between mb-4")
                                h3(class="text-lg font-bold text-slate-900") Sales Trend (6 Months)
                                p(class="text-xs text-slate-500") Updated live
                            div(id="salesTrendChart" class="grid grid-cols-6 gap-3 items-end min-h-[200px]")
                        div(class="bg-white rounded-xl border border-slate-200 p-5")
                            h3(class="text-lg font-bold text-slate-900 mb-4") Order Status
                            ul(id="orderStatusList" class="space-y-2")

                    div(class="grid grid-cols-1 xl:grid-cols-2 gap-4")
                        div(class="bg-white rounded-xl border border-slate-200 overflow-hidden")
                            div(class="px-5 py-4 border-b border-slate-200")
                                h3(class="text-lg font-bold text-slate-900") Recent Orders
                            div(class="overflow-x-auto")
                                table(class="w-full text-left border-collapse")
                                    thead
                                        tr(class="bg-slate-50 border-b border-slate-200")
                                            th(class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider") Order
                                            th(class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider") Customer
                                            th(class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider") Total
                                            th(class="px-5 py-3 text-xs font-bold text-slate-500 uppercase tracking-wider") Status
                                    tbody(id="recentOrdersBody" class="divide-y divide-slate-100")

                        div(class="bg-white rounded-xl border border-slate-200 overflow-hidden")
                            div(class="px-5 py-4 border-b border-slate-200")
                                h3(class="text-lg font-bold text-slate-900") Recent Appointments
                            ul(id="recentAppointmentsList" class="divide-y divide-slate-100")

                    div(class="bg-white rounded-xl border border-slate-200 p-5")
                        h3(class="text-lg font-bold text-slate-900 mb-4") Top Products by Quantity Sold
                        ul(id="topProductsList" class="space-y-2")

    div(id="toast" class="fixed bottom-6 right-6 z-50 rounded-lg px-4 py-3 text-sm font-semibold text-white opacity-0 transition-opacity duration-300 bg-[#CF1745] pointer-events-none")

block scripts
    script(src='/js/dashboard.js')
