doctype html
html
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      link(rel='stylesheet' href='/css/style.css')
      link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700' rel='stylesheet')
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Teachers:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
      script(src='https://kit.fontawesome.com/c538f0b152.js' crossorigin='anonymous')
      script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
      link(rel='shortcut icon' type='image/png' href='/images/logo-3.png')
      title E & R Salon | Admin Dashboard
      
  body
    // HEADER
    if(currentUrl === '/login')
        nav(class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md")
            div(class="max-w-7xl mx-auto px-6 h-25 flex items-center justify-between py-3")
                // Logo
                a(href="/", class="text-4xl font-bold text-primary font-dancing") 
                    img(src="/images/logo-3.png", alt="Salon Logo", class="h-20 w-auto")

                // Desktop Links
                div(class="flex items-center gap-6")
                    h1(class="font-semibold text-xl italic") Welcome to Admin Dashboard
    else
      include _adminHeader

    // CONTENT (This block is replaced by overview.pug)
    block content
      h1 This is a fallback heading

    // FOOTER
    include _adminFooter

    // SCRIPT
    script(src='/js/index.js') 
    block scripts