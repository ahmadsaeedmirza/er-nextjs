doctype html
html
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      link(rel='stylesheet' href='/css/style.css')
      link(href='https://fonts.googleapis.com/css?family=Lato:300,300i,700' rel='stylesheet')
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Teachers:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
      script(src='https://kit.fontawesome.com/c538f0b152.js' crossorigin='anonymous')
      script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
      link(rel='shortcut icon' type='image/png' href='/images/logo-3.png')
      title E & R Salon | #{title}
      
  body
    // HEADER
    include _header

    // CONTENT (This block is replaced by overview.pug)
    block content
      h1 This is a fallback heading

    // FOOTER
    include _footer

    // TOAST NOTIFICATION
    div(id="toast", class="fixed top-24 left-1/2 transform -translate-x-1/2 bg-[#CF1745] text-white px-6 py-3 rounded-lg shadow-lg opacity-0 transition-opacity duration-300 z-50 pointer-events-none")
        | Item added to cart!

    // SCRIPT
    script(src='/js/index.js') 
    block scripts